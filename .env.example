# ─────────────────────────────────────────────────────────────────────────────
# CONNECT — Environment Variables Template
# Copy this file to .env and fill in real values.
# The .env file is git-ignored. NEVER commit secrets.
# ─────────────────────────────────────────────────────────────────────────────


# ── EXPO / REACT NATIVE FRONTEND ─────────────────────────────────────────────

# Base URL for the Connect backend API (Envoy gateway)
EXPO_API_BASE_URL=http://localhost:5000/api/v1

# Set to true to bypass real API calls and use local mock data
EXPO_USE_MOCK=false

# Azure / OAuth tenant ID used by the identity provider for JWT issuance
EXPO_TENANT_ID=


# ── CONNECT-CORE BACKEND ──────────────────────────────────────────────────────

# PostgreSQL connection string (zero raw financial data stored here)
DATABASE_URL=postgresql://postgres:password@localhost:5432/connect_db

# Neo4j graph database credentials
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Pinecone vector store — tier-gated index
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=us-east-1-aws
PINECONE_INDEX_NAME=connect-profiles

# Kafka broker (used by streaming producer)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── LLM LAYER — LOCAL HERMES / OLLAMA ────────────────────────────────────────

# Ollama / Hermes Desktop Harness endpoint (System 2 inference)
HERMES_ENDPOINT=http://localhost:11434/api/generate
HERMES_MODEL=qwen2.5:3b

# Optional GitHub PAT for the validation_hooks GitHub API tool
# (raises rate limit from 60 to 5000 req/hr — safe to leave blank in dev)
GITHUB_API_TOKEN=

# ── JWT / AUTH ────────────────────────────────────────────────────────────────

# Connect identity provider — must match envoy auth_token_schema.yaml issuer
AUTH_ISSUER=https://auth.connect.app
AUTH_AUDIENCE=connect-mobile-client

# Secret used to sign tokens in local dev only — use proper KMS in production
JWT_SECRET_DEV_ONLY=CHANGE_ME_IN_PRODUCTION

# ── ENVOY GATEWAY ────────────────────────────────────────────────────────────

# Ports that Envoy routes traffic to (must match envoy.yaml cluster addresses)
BACKEND_PORT=5000
ELITE_SERVICE_PORT=5001
TELEMETRY_SERVICE_PORT=5002
