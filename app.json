    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0B0C"
      },
      "package": "com.connect.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
