# ─────────────────────────────────────────────────────────────────────────────
# CONNECT — .gitattributes
# Ensures consistent line endings across OS environments
# ─────────────────────────────────────────────────────────────────────────────

# Auto-detect text files and normalize to LF on commit
* text=auto eol=lf

# Explicitly LF for source files
*.ts     text eol=lf
*.tsx    text eol=lf
*.js     text eol=lf
*.jsx    text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.py     text eol=lf
*.sh     text eol=lf
*.env*   text eol=lf
*.txt    text eol=lf
*.css    text eol=lf
*.html   text eol=lf
*.sql    text eol=lf
*.cypher text eol=lf

# Binary files — no line-ending conversion
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.svg    binary
*.webp   binary
*.ttf    binary
*.otf    binary
*.woff   binary
*.woff2  binary
*.eot    binary
*.pdf    binary
*.zip    binary
*.tar    binary
*.gz     binary
*.apk    binary
*.ipa    binary
*.aab    binary
*.gguf   binary
*.safetensors binary
*.pt     binary
*.onnx   binary

# Linguist overrides (GitHub language detection)
connect-core/backend/** linguist-language=Python
screens/**              linguist-language=TypeScript
services/**             linguist-language=TypeScript
navigation/**           linguist-language=TypeScript
components/**           linguist-language=TypeScript
context/**              linguist-language=TypeScript
data/**                 linguist-language=TypeScript
